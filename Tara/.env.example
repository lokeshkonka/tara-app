EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Leave EMPTY in dev: the app derives your PC's LAN IP from the Expo dev server
# (Constants.expoConfig.hostUri) and appends EXPO_PUBLIC_API_PORT (default 3000).
# Set a full URL (e.g. https://api.example.com) for production/remote backends.
EXPO_PUBLIC_API_BASE_URL=
# Port used when EXPO_PUBLIC_API_BASE_URL is empty (backend's PORT, default 3000)
EXPO_PUBLIC_API_PORT=3000
# "backend" uses the real API, "local" uses a mock session (useful for UI-only work)
EXPO_PUBLIC_AUTH_MODE=backend
